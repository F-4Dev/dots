{
    "layer": "bottom",
    "height": 35,
    "spacing": 15,
    "reload_style_on_change": true,
    "output": [
        "HDMI-A-1"
    ],
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "backlight/slider",
        "custom/hypridle",
        "network",
        "privacy",
        "pulseaudio",
        "clock",
        "custom/notifications"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate"
    },
    "tray": {
        "spacing": 10,
        "icons": {
            "vesktop": "/home/f4/.config/waybar/icons/discord.svg",
            "kdeconnect": "/home/f4/.config/waybar/icons/kde-connect.svg"
        }
    },
    "hyprland/window": {
        "max-length": 60
    },
    "clock": {
        "tooltip": false,
        "format": "[ {:%a. %d. %b %H:%M} ]"
    },
    "pulseaudio": {
        "format": "[ {icon} {volume}% ]",
        "format-muted": "<span size='x-large'>  </span",
        "format-icons": {
            "default": [
                " ",
                " ",
                " ",
                " ",
                " ",
                " ",
                " ",
                " ",
                " ",
                " "
            ]
        },
        "tooltip-format": "{volume}% Volume",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.50 @DEFAULT_SINK@ 10%+",
        "on-scroll-down": "wpctl set-volume -l 0.0 @DEFAULT_SINK@ 10%-",
        "on-click-forward": "wpctl set-volume -l 0.0 @DEFAULT_SINK@ 1%+",
        "on-click-backward": "wpctl set-volume -l 0.0 @DEFAULT_SINK@ 1%-"
    },
    "custom/notifications": {
        "format": "{icon}",
        "format-icons": {
            "default": "󰂚   ",
            "disabled": "󰂛   "
        },
        "tooltip": false,
        "on-click": "swaync-client -t -sw",
        "signal": 1
    },
    "network": {
        "tooltip": false,
        "interface": "enp5s0",
        "format": "{ifname}",
        "format-ethernet": "󰛳 ",
        "format-disconnected": "󰲜 ",
        "max-length": 50
    }
}